<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned, audited dependency sources. The <auditSources> declaration is load-bearing:
  without it, a reachable source that provides no vulnerability database makes both the
  restore-time NuGet audit and the package-list vulnerability gate silently vacuous
  (verified by live repro in the 2026-07-16 audit, DEPE-01). With it, NU1905 fires when
  audit data is unavailable and -warnaserror makes that fail closed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
