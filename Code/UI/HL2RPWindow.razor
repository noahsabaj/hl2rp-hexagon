@using System
@using Sandbox.UI
@namespace HL2RP.UI
@inherits Panel

<root class="hex-window @Variant">
	<div class="hex-window__header">
		<div class="hex-window__identity">
			@if ( !string.IsNullOrWhiteSpace( Eyebrow ) )
			{
				<div class="hex-window__eyebrow">@Eyebrow</div>
			}
			<div class="hex-window__title">@Title</div>
			@if ( !string.IsNullOrWhiteSpace( Subtitle ) )
			{
				<div class="hex-window__subtitle">@Subtitle</div>
			}
		</div>
		<div class="hex-window__actions">
			@HeaderActions
			@if ( OnClose is not null )
			{
				<button class="hex-icon-button" @onclick="OnClose" aria-label="Close panel">close</button>
			}
		</div>
	</div>
	<div class="hex-window__body">@Body</div>
	@if ( Footer is not null )
	{
		<div class="hex-window__footer">@Footer</div>
	}
</root>

@code
{
	[Parameter] public string Eyebrow { get; set; }
	[Parameter] public string Title { get; set; }
	[Parameter] public string Subtitle { get; set; }
	[Parameter] public string Variant { get; set; }
	[Parameter] public RenderFragment Body { get; set; }
	[Parameter] public RenderFragment HeaderActions { get; set; }
	[Parameter] public RenderFragment Footer { get; set; }
	[Parameter] public Action OnClose { get; set; }

	protected override int BuildHash() => HashCode.Combine( Eyebrow, Title, Subtitle, Variant );
}
