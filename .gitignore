
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated editor and project metadata
/.vs/
/.vscode/
/.idea/
/.sbox/
/Code/*.csproj
/Code/obj/
/Code/bin/
/Code/Properties/launchSettings.json
/Editor/*.csproj
/Editor/obj/
/Editor/bin/
/Editor/Properties/launchSettings.json
/tests/obj/
/tests/bin/
/*.sln
/*.slnx

# Compiled asset outputs
/Assets/**/*_c
/Assets/**/*_d
/Assets/**/*.los
/Assets/**/*.vpk

# Exported / standalone games
/Exports/

# Symlinked libraries (managed separately)
/Libraries/

/nul
