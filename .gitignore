
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
!tests/**/*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*
ProjectSettings/Platform.config

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx
!tests/**/*.sln
!tests/**/*.slnx

*idea

# Exported / standalone games
Exports/

# Symlinked libraries (managed separately)
Libraries/

nul
